{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suirabox.dev/schema/resource-manifest-v1.json",
  "title": "SuiraBox Resource Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "resources"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_version": {"type": "integer", "minimum": 1},
    "resources": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-z0-9._-]+(?:/[a-z0-9._-]+)*$",
      "maxLength": 63
    },
    "path": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-z0-9._-]+(?:/[a-z0-9._-]+)*$",
      "maxLength": 127
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "type", "tier", "size", "expanded_size",
        "sha256", "path", "compression", "min_os", "dependencies"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "type": {"enum": ["locale", "theme", "wallpaper", "icon", "font", "app", "sound", "document"]},
        "tier": {"enum": ["builtin", "optional", "remote"]},
        "size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "expanded_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"},
        "path": {"$ref": "#/$defs/path"},
        "compression": {"enum": ["none", "zstd"]},
        "min_os": {"type": "integer", "minimum": 1},
        "dependencies": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    }
  }
}
